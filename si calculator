#include<stdio.h>
int sicalculator(){
    int p,t,r,si;
    printf("enter a principle\n");
    scanf("%d",&p);
    printf("enter a time\n");
    scanf("%d",&t);
    printf("enter a interest\n");
    scanf("%d",&r);
    si=(p*t*r)/100;
    printf("simple interest=%d\n",si);
}
int main(){
    sicalculator();
}
